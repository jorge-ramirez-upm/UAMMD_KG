{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kg-assoc-campaign-system-v1",
  "type": "object",
  "required": ["schema_version", "system_id", "associating", "f", "N", "rho_p", "number_of_stars", "replicas", "production_steps"],
  "properties": {
    "schema_version": {"const": 1},
    "system_id": {"type": "string", "pattern": "^F[0-9]{2}_N[0-9]{3}_RP[0-9]{3}_(NONASSOC|EE[0-9]{2}_EA[0-9]{2})$"},
    "associating": {"type": "boolean"},
    "f": {"type": "integer", "minimum": 1},
    "N": {"type": "integer", "minimum": 1},
    "rho_p": {"type": "number", "exclusiveMinimum": 0},
    "Ee": {"type": ["number", "null"]},
    "Ea": {"type": ["number", "null"]},
    "number_of_stars": {"type": "integer", "minimum": 1},
    "replicas": {"const": 3},
    "production_steps": {"const": 100000000},
    "groups": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": true
}
