{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kg-assoc-campaign-run-v1",
  "type": "object",
  "required": ["schema_version", "system_id", "replica", "status", "completed_production_steps", "parent_e1", "parent_e2", "md_seed", "chemistry_seed", "production_continuation", "geometry", "output_cadence_steps"],
  "properties": {
    "schema_version": {"const": 1},
    "system_id": {"type": "string"},
    "replica": {"type": "integer", "minimum": 1, "maximum": 3},
    "status": {"enum": ["prepared", "running", "incomplete", "complete", "invalid"]},
    "completed_production_steps": {"type": "integer", "minimum": 0, "maximum": 100000000},
    "parent_e1": {"type": "string", "minLength": 1},
    "parent_e2": {"type": ["string", "null"]},
    "md_seed": {"type": "integer", "minimum": 1},
    "chemistry_seed": {"type": "integer", "minimum": 1},
    "production_continuation": {"const": false},
    "geometry": {"type": "object"},
    "output_cadence_steps": {"type": "object"},
    "attempt": {"type": "integer", "minimum": 1},
    "command": {"type": "array", "items": {"type": "string"}},
    "exit_code": {"type": ["integer", "null"]},
    "validation": {"type": "object"},
    "files": {"type": "object"}
  },
  "additionalProperties": true
}
