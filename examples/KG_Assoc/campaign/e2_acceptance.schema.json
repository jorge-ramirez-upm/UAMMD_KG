{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kg-assoc-e2-acceptance-v1",
  "type": "object",
  "required": ["schema_version", "stage", "bank_id", "provenance_kind", "status", "reviewer", "reviewed_at", "evidence", "evidence_sha256", "source_plan", "source_plan_sha256", "histories", "permitted_use", "permitted_systems", "qualification", "numerical_qualification", "publisher_git_sha"],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"const": "E2_acceptance"},
    "bank_id": {"type": "string", "pattern": "^F[0-9]{2}_N[0-9]{3}_RP[0-9]{3}_EE[0-9]{2}$"},
    "provenance_kind": {"enum": ["E2_G1_segment", "corrected_C1_8M"]},
    "status": {"enum": ["accepted", "accepted_with_qualification"]},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1},
    "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_plan": {"type": "string", "minLength": 1},
    "source_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "histories": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["replica", "prefix", "end_step", "chemistry_seed", "physics", "sha256"],
        "properties": {
          "replica": {"type": "integer", "minimum": 1, "maximum": 3},
          "prefix": {"type": "string", "minLength": 1},
          "end_step": {"type": "integer", "minimum": 1},
          "chemistry_seed": {"type": "integer", "minimum": 1},
          "physics": {"type": "object"},
          "lineage": {"type": "object", "required": ["mode", "reference_acceptance", "reference_acceptance_sha256", "branch_id", "parent_chemistry_seed", "branch_origin_step", "parent_creations", "parent_breaks"], "properties": {"mode": {"const": "Ea_reference_transfer_v1"}, "reference_control": {"const": false}, "bitwise_md_continuation": {"const": false}}},
          "sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
        },
        "additionalProperties": false
      }
    },
    "permitted_use": {"const": "production_initial_state"},
    "permitted_systems": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "qualification": {"type": "string"},
    "numerical_qualification": {"type": "string", "minLength": 1},
    "publisher_git_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "accepted_with_qualification"}}}, "then": {"properties": {"qualification": {"minLength": 1}}}}],
  "additionalProperties": false
}
