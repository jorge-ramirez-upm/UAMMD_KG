    "cellIndex": "inline int cellIndex(double coordinate, double length, int cells) {\n  const double cellLength = length / static_cast<double>(cells);\n  int index = static_cast<int>(std::floor((coordinate + 0.5 * length) / cellLength));\n  if (index < 0) {\n    return 0;\n  }\n  if (index >= cells) {\n    return cells - 1;\n  }\n  return index;\n}"
